---
import type { PostSummary } from '~/types'
import { themeConfig } from '~/.config'
import { formatDate, getPathFromCategory } from '~/utils'

interface Props {
  post: PostSummary
  compact?: boolean
  headingLevel?: 'h2' | 'h3'
}

const { post, compact = false, headingLevel = 'h2' } = Astro.props
const Heading = headingLevel
const displayDate = post.modDate ?? post.pubDate
---

<article class:list={['group', compact ? 'py-4' : 'py-6']}>
  <div class="mb-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-3 c-[var(--color-muted)]">
    {post.pin && <span class="font-bold tracking-wide">置顶</span>}
    <time datetime={displayDate.toISOString()}>{formatDate(displayDate)}</time>
    {
      post.categories.map((category) => (
        <a
          class="not-underline-hover font-bold"
          href={`/categories/${getPathFromCategory(category, themeConfig.site.categoryMap)}`}
        >
          {category}
        </a>
      ))
    }
  </div>

  <Heading class:list={['m-0 font-bold lh-snug', compact ? 'text-4.5' : 'text-5.5']}>
    <a class="break-words" href={post.href}>{post.title}</a>
  </Heading>

  {!compact && post.description && <p class="mb-0 mt-3 line-clamp-2 lh-7 c-[var(--color-muted)]">{post.description}</p>}

  {
    post.tags.length > 0 && (
      <div class="mt-3 flex flex-wrap gap-x-2 gap-y-1 text-3.25">
        {post.tags.map((tag) => (
          <a href={`/tags/${tag}`}>#{tag}</a>
        ))}
      </div>
    )
  }
</article>
