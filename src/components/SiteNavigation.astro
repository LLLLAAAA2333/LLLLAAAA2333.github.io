---
import { themeConfig } from '~/.config'
import SearchDialog from '~/components/SearchDialog.astro'
import SiteFooter from '~/components/SiteFooter.astro'
import ThemeToggle from '~/components/ThemeToggle.astro'

const { navLinks, socialLinks, author, description } = themeConfig.site
const { translate: t } = Astro.locals
---

<div class="mb-7 w-full border-b border-[var(--color-border)] pb-6 text-center font-ui">
  <!-- deslop-ignore-next-line 19 -->
  <img src="/hornet.png" alt={author || '站点头像'} class="mx-auto mb-3 h-24 w-24 rounded-full shadow-lg" />
  {author && <h2 class="m-0 text-xl font-bold">{author}</h2>}
  {description && <p class="mb-0 mt-2 text-sm">{description}</p>}
  <footer class="mt-3" aria-label="站点版权信息">
    <SiteFooter />
  </footer>
</div>
<nav class="text-center font-bold font-ui" flex="~ col gap-4">
  <ul lg="flex-col items-start text-4" class="text-3.5" flex="~ row gap-2 justify-center">
    {
      navLinks.map((nav) => (
        <li>
          <a
            href={nav.href}
            aria-current={
              Astro.url.pathname === nav.href || (nav.href !== '/' && Astro.url.pathname.startsWith(nav.href))
                ? 'page'
                : undefined
            }
          >
            {t(nav.name)}
          </a>
        </li>
      ))
    }
    <li>
      <SearchDialog />
    </li>
  </ul>
  <ul flex="~ row gap-1 justify-center items-center">
    {
      socialLinks.map(({ href, name }) => (
        <li>
          <a href={href} target="_blank" title={name} class="not-underline-hover inline-flex items-center">
            <span class:list={[`i-mdi-${name}`, 'w-6 h-6']}>{name}</span>
          </a>
        </li>
      ))
    }
    <li>
      <ThemeToggle />
    </li>
  </ul>
</nav>
