---
import { themeConfig } from '~/.config'
import SearchDialog from '~/components/SearchDialog.astro'
import ThemeToggle from '~/components/ThemeToggle.astro'
import { isNavLinkActive } from '~/utils/navigation'

const { navLinks, socialLinks, author } = themeConfig.site
const { translate: t } = Astro.locals

const navigationIcons: Record<string, string> = {
  Posts: 'i-tabler-file-text',
  Archive: 'i-tabler-archive',
  Categories: 'i-tabler-category',
  Tags: 'i-tabler-tags',
  About: 'i-tabler-user-circle',
}
---

<div class="site-profile font-ui">
  <img src="/hornet.png" alt={author || '站点头像'} width="80" height="80" class="site-avatar" />
  {author && <h2 class="m-0 mt-2 text-4 font-bold">{author}</h2>}
  <ul class="site-tools" aria-label="社交链接与外观设置">
    {
      socialLinks.map(({ href, name }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            title={name === 'github' ? 'GitHub' : name === 'rss' ? 'RSS 订阅' : name}
            aria-label={name === 'github' ? 'GitHub' : name === 'rss' ? 'RSS 订阅' : name}
            class="site-tool not-underline-hover"
          >
            <span
              class:list={[name === 'github' ? 'i-tabler-brand-github' : `i-tabler-${name}`, 'site-icon']}
              aria-hidden="true"
            />
          </a>
        </li>
      ))
    }
    <li>
      <ThemeToggle />
    </li>
  </ul>
</div>
<nav class="site-menu font-ui" aria-label="主导航">
  <ul class="site-menu-list">
    {
      navLinks.map((nav) => (
        <li>
          <a
            href={nav.href}
            class="site-menu-link not-underline-hover"
            aria-current={isNavLinkActive(nav.href, Astro.url.pathname) ? 'page' : undefined}
          >
            <span class:list={[navigationIcons[nav.name] ?? 'i-tabler-link', 'site-icon']} aria-hidden="true" />
            <span>{t(nav.name)}</span>
          </a>
        </li>
      ))
    }
    <li>
      <SearchDialog />
    </li>
  </ul>
</nav>

<script>
  import { isNavLinkActive } from '~/utils/navigation'

  function updateCurrentLink() {
    document.querySelectorAll<HTMLAnchorElement>('.site-menu-link[href]').forEach((link) => {
      if (!isNavLinkActive(new URL(link.href).pathname, window.location.pathname)) {
        link.removeAttribute('aria-current')
        return
      }
      link.setAttribute('aria-current', 'page')
    })
  }

  updateCurrentLink()
  document.addEventListener('swup:page:view', updateCurrentLink)
</script>
