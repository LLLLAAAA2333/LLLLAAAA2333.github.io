<dialog
  id="image-lightbox"
  class="image-lightbox relative m-auto h-auto max-h-[96dvh] w-auto max-w-[96vw] border-0 bg-transparent p-0 c-white"
  aria-label="图片大图"
>
  <button
    type="button"
    class="image-lightbox-close not-underline-hover absolute right-2 top-2 z-1 inline-flex h-10 w-10 items-center justify-center border border-white/35 bg-black/70 c-white cursor-pointer"
    aria-label="关闭大图"
  >
    <span class="i-mdi-close h-6 w-6" aria-hidden="true"></span>
  </button>
  <img class="block max-h-[96dvh] max-w-[96vw] object-contain" alt="" />
</dialog>

<script>
  const LIGHTBOX_BOUND = Symbol.for('article-lightbox-bound')
  const lightboxWindow = window as unknown as Window & Record<symbol, boolean | undefined>
  let activeImage: HTMLImageElement | null = null

  function getLightbox() {
    return document.querySelector<HTMLDialogElement>('#image-lightbox')
  }

  function closeLightbox() {
    const dialog = getLightbox()
    if (dialog?.open) {
      dialog.close()
    }
  }

  function openLightbox(source: HTMLImageElement) {
    const dialog = getLightbox()
    const preview = dialog?.querySelector<HTMLImageElement>('img')
    if (!dialog || !preview) {
      return
    }

    activeImage = source
    preview.src = source.currentSrc || source.src
    preview.alt = source.alt
    if (!dialog.open) {
      dialog.showModal()
    }
  }

  function prepareLightbox() {
    document.querySelectorAll<HTMLImageElement>('main article.prose img').forEach((image) => {
      if (image.closest('a')) {
        return
      }
      image.classList.add('image-zoomable')
      image.tabIndex = 0
      image.setAttribute('role', 'button')
      image.setAttribute('aria-label', '查看图片大图')
    })

    const dialog = getLightbox()
    if (dialog && !dialog.dataset.closeBound) {
      dialog.dataset.closeBound = 'true'
      dialog.addEventListener('close', () => {
        const preview = dialog.querySelector<HTMLImageElement>('img')
        if (preview) {
          preview.removeAttribute('src')
        }
        activeImage?.focus()
        activeImage = null
      })
    }
  }

  if (!lightboxWindow[LIGHTBOX_BOUND]) {
    lightboxWindow[LIGHTBOX_BOUND] = true

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) {
        return
      }

      const closeButton = event.target.closest('.image-lightbox-close')
      if (closeButton) {
        closeLightbox()
        return
      }

      const dialog = getLightbox()
      if (event.target === dialog) {
        closeLightbox()
        return
      }

      const image = event.target.closest<HTMLImageElement>('main article.prose img.image-zoomable')
      if (image) {
        openLightbox(image)
      }
    })

    document.addEventListener('keydown', (event) => {
      if (!(event.target instanceof HTMLImageElement)) {
        return
      }
      if (!event.target.matches('main article.prose img.image-zoomable')) {
        return
      }
      if (event.key !== 'Enter' && event.key !== ' ') {
        return
      }
      event.preventDefault()
      openLightbox(event.target)
    })

    document.addEventListener('swup:page:view', () => {
      closeLightbox()
      prepareLightbox()
    })
  }

  prepareLightbox()
</script>

<style is:global>
  .image-lightbox::backdrop {
    background: color-mix(in srgb, #000 88%, transparent);
  }

  .image-zoomable {
    cursor: zoom-in;
  }

  .image-zoomable:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
  }
</style>
