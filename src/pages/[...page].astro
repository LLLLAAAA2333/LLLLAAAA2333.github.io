---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import { themeConfig } from '~/.config'
import Pagination from '~/components/Pagination.astro'
import PostSummaryItem from '~/components/PostSummaryItem.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { getPostSummary, getPosts } from '~/utils'

const { translate: t } = Astro.locals

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPosts()
  posts.sort((a, b) => {
    if (a.data.pin && !b.data.pin) return -1
    if (!a.data.pin && b.data.pin) return 1
    return 0
  })

  return paginate(posts, {
    pageSize: themeConfig.site.pageSize,
  })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { page } = Astro.props
const isFirstPage = page.currentPage === 1
---

<LayoutDefault>
  <SiteSeo
    slot="seo"
    title={page.currentPage === 1 ? themeConfig.site.title : `${themeConfig.site.title} - Page ${page.currentPage}`}
    desc={themeConfig.site.description}
    canonical={page.url.current}
    type="website"
  />
  <section aria-labelledby="latest-posts">
    <header class="mb-2 flex items-baseline justify-between gap-4 border-b border-[var(--color-border)] pb-4">
      <h1 id="latest-posts" class="m-0 text-7 font-bold font-ui">
        {isFirstPage ? '最新文章' : `全部文章 · ${page.currentPage}`}
      </h1>
      <div class="flex shrink-0 items-baseline gap-4 text-3.5">
        <span class="c-[var(--color-muted)]">{page.total} 篇文章</span>
        {!isFirstPage && <a href="/archive">查看归档</a>}
      </div>
    </header>
    {page.data.map((post) => <PostSummaryItem post={getPostSummary(post)} />)}
  </section>

  <Pagination
    showLeft={Boolean(page.url.prev)}
    leftTitle={t('prev')}
    leftUrl={page.url.prev}
    showRight={Boolean(page.url.next)}
    rightTitle={t('next')}
    rightUrl={page.url.next}
    currentPage={page.currentPage}
    totalPage={page.lastPage}
  />
</LayoutDefault>
