---
import { themeConfig } from '~/.config'
import CategoryCard from '~/components/CategoryCard.astro'
import SiteSeo from '~/components/SiteSeo.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { getCategories } from '~/utils/index'

const { translate: t } = Astro.locals
const categoryMap = await getCategories()

const list = Array.from(categoryMap.entries()).sort(([, a], [, b]) => b.length - a.length)
---

<LayoutDefault>
  <SiteSeo
    slot="seo"
    title={t('Categories')}
    desc={themeConfig.site.description}
    canonical="/categories/"
    type="website"
  />
  <header class="mb-8 flex items-baseline justify-between gap-4 border-b border-[var(--color-border)] pb-4">
    <h1 class="m-0 text-7 font-bold font-ui">{t('Categories')}</h1>
    <p class="m-0 shrink-0 text-3.5 c-[var(--color-muted)]">{list.length} 个分类</p>
  </header>

  {
    list.length === 0 ? (
      <p class="c-[var(--color-muted)]">尚无分类。</p>
    ) : (
      <ul class="category-grid">
        {list.map(([category, posts]) => (
          <li>
            <CategoryCard category={category} posts={posts} />
          </li>
        ))}
      </ul>
    )
  }
</LayoutDefault>

<style>
  .category-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
