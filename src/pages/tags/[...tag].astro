---
// src/pages/tags/[...tag].astro
import SiteSeo from '~/components/SiteSeo.astro'
import { themeConfig } from '~/.config'
import PostSummaryItem from '~/components/PostSummaryItem.astro'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import { getPostSummary, getTags } from '~/utils'

export async function getStaticPaths() {
  const tags = await getTags()
  return Array.from(tags.entries()).map(([tag, posts]) => {
    return {
      params: { tag },
      props: { posts, name: tag },
    }
  })
}

const { posts, name } = Astro.props
---

<LayoutDefault>
  <SiteSeo
    slot="seo"
    title={`Tag: ${name}`}
    desc={themeConfig.site.description}
    canonical={`/tags/${name}/`}
    type="website"
  />
  <header class="mb-4 flex items-baseline justify-between gap-4 border-b border-[var(--color-border)] pb-4">
    <h1 class="m-0 break-words text-7 font-bold font-ui"># {name}</h1>
    <p class="m-0 shrink-0 text-3.5 c-[var(--color-muted)]">{posts.length} 篇文章</p>
  </header>

  <section aria-label={`${name} 标签文章`}>
    {
      posts.length === 0 ? (
        <p class="c-[var(--color-muted)]">该标签暂无文章。</p>
      ) : (
        posts.map((post) => <PostSummaryItem post={getPostSummary(post)} />)
      )
    }
  </section>
</LayoutDefault>
