---
import SiteSeo from '~/components/SiteSeo.astro'
import { themeConfig } from '~/.config'
import LayoutDefault from '~/layouts/LayoutDefault.astro'
import type { PostSummary } from '~/types'
import { formatDate, getPostSummary, getPosts } from '~/utils'

const { translate: t } = Astro.locals
const posts = await getPosts(true)

function getYearMap(posts: PostSummary[]) {
  const result = new Map<number, PostSummary[]>()
  for (const post of posts) {
    const year = post.pubDate.getFullYear()
    const yearPosts = result.get(year) ?? []
    yearPosts.push(post)
    result.set(year, yearPosts)
  }
  return Array.from(result.entries())
}
---

<LayoutDefault>
  <SiteSeo slot="seo" title={t('Archive')} desc={themeConfig.site.description} canonical="/archive/" type="website" />
  <header class="mb-8 flex items-baseline justify-between gap-4 border-b border-[var(--color-border)] pb-4">
    <h1 class="m-0 text-7 font-bold font-ui">{t('Archive')}</h1>
    <p class="m-0 shrink-0 text-3.5 c-[var(--color-muted)]">{posts.length} 篇文章</p>
  </header>

  <div class="flex flex-col gap-12">
    {
      getYearMap(posts.map((post) => getPostSummary(post, false))).map(([year, yearPosts]) => (
        <section class="grid gap-4 md:grid-cols-[5rem_minmax(0,1fr)]">
          <h2 class="m-0 text-6 font-bold font-ui">{year}</h2>
          <ol class="m-0 list-none border-t border-[var(--color-border)] p-0">
            {yearPosts.map((post) => (
              <li class="grid gap-1 border-b border-[var(--color-border)] py-3 sm:grid-cols-[4rem_minmax(0,1fr)_auto] sm:items-baseline sm:gap-4">
                <time class="text-3.5 c-[var(--color-muted)]" datetime={post.pubDate.toISOString()}>
                  {formatDate(post.pubDate, 'MM-DD')}
                </time>
                <h3 class="m-0 min-w-0 text-4.5 font-bold">
                  <a class="break-words" href={post.href}>
                    {post.title}
                  </a>
                </h3>
                <span class="text-3 c-[var(--color-muted)]">{post.categories[0]}</span>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</LayoutDefault>
